---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'EzyMoneyExchange - Currency Converter',
  description = 'A simple currency converter with clear rates and quick amount presets.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f8f5" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
